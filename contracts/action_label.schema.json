{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YP Action-Spotting Label Contract",
  "version": "2.0.0",
  "description": "Source of truth for the *_actions.jsonl label records and frame cache layout exchanged between yp-video (producer) and yp-spot (consumer). Generated from yp_video/contracts/action.py via make_schema.py \u2014 do not edit by hand. yp-spot mirrors these constants in yp_spot/contract.py under the same version.",
  "x-frame-layout": {
    "height": 224,
    "ffmpeg_pattern": "%06d.jpg",
    "py_pattern": "{:06d}.jpg",
    "glob": "*.jpg",
    "zero_based": true
  },
  "x-label-file-glob": "*_actions.jsonl",
  "x-tasks": {
    "rally": {
      "name": "rally",
      "label": "Rally",
      "kind": "segment",
      "label_subdir": "rally-annotations",
      "label_glob": "*_rally.jsonl",
      "event_fields": [
        "frame",
        "end_frame"
      ],
      "requires": [],
      "primary_metric": "segment_mAP",
      "serveable": true,
      "loss_weight": 1.0
    },
    "winner": {
      "name": "winner",
      "label": "Winner",
      "kind": "aux",
      "label_subdir": "rally-annotations",
      "label_glob": "*_rally.jsonl",
      "event_fields": [
        "winner"
      ],
      "requires": [
        "rally"
      ],
      "primary_metric": "winner_top1",
      "serveable": true,
      "loss_weight": 1.0
    },
    "action": {
      "name": "action",
      "label": "Action",
      "kind": "point",
      "label_subdir": "action-annotations",
      "label_glob": "*_actions.jsonl",
      "event_fields": [
        "frame",
        "label"
      ],
      "requires": [],
      "primary_metric": "harmonic_mAP",
      "serveable": true,
      "loss_weight": 1.0
    },
    "location": {
      "name": "location",
      "label": "Location",
      "kind": "aux",
      "label_subdir": "action-annotations",
      "label_glob": "*_actions.jsonl",
      "event_fields": [
        "xy"
      ],
      "requires": [
        "action"
      ],
      "primary_metric": "spatial_mAP",
      "serveable": false,
      "loss_weight": 1.0
    },
    "actor": {
      "name": "actor",
      "label": "Actor",
      "kind": "aux",
      "label_subdir": "actor-candidates",
      "label_glob": "*_actor_candidates.jsonl",
      "event_fields": [],
      "requires": [
        "action",
        "location"
      ],
      "primary_metric": "player_top1",
      "serveable": true,
      "loss_weight": 1.0
    }
  },
  "x-recipes": {
    "rally": {
      "id": "rally",
      "name": "Rally",
      "tasks": [
        "rally"
      ],
      "description": "Rally on/off segments from the rally annotations.",
      "fields": [
        "sample_fps",
        "video_limit"
      ],
      "defaults": {
        "batch_size": 8,
        "acc_grad_iter": 1,
        "num_epochs": 30,
        "warm_up_epochs": 2,
        "learning_rate": 0.0003,
        "audio_backend": "none"
      }
    },
    "rally_winner": {
      "id": "rally_winner",
      "name": "Rally + Winner",
      "tasks": [
        "rally",
        "winner"
      ],
      "description": "Rally segments plus which court side won each rally.",
      "fields": [
        "sample_fps",
        "video_limit"
      ],
      "defaults": {
        "batch_size": 8,
        "acc_grad_iter": 1,
        "num_epochs": 30,
        "warm_up_epochs": 2,
        "learning_rate": 0.0003,
        "audio_backend": "none"
      }
    },
    "action": {
      "id": "action",
      "name": "Action",
      "tasks": [
        "action",
        "location"
      ],
      "description": "Touch spotting with the contact-point location head.",
      "fields": [
        "sample_fps",
        "acc_grad_iter",
        "audio_backend",
        "include_predictions"
      ],
      "defaults": {
        "batch_size": 32,
        "acc_grad_iter": 4,
        "num_epochs": 100,
        "warm_up_epochs": 3,
        "learning_rate": 1e-05,
        "audio_backend": "logmel"
      }
    },
    "association_action": {
      "id": "association_action",
      "name": "Association + Action",
      "tasks": [
        "action",
        "location",
        "actor"
      ],
      "description": "Touch spotting plus which player acted, from the actor-candidate sidecar.",
      "fields": [
        "sample_fps",
        "acc_grad_iter",
        "audio_backend",
        "include_predictions",
        "dataset_scope"
      ],
      "defaults": {
        "batch_size": 8,
        "acc_grad_iter": 1,
        "num_epochs": 50,
        "warm_up_epochs": 3,
        "learning_rate": 3e-05,
        "audio_backend": "logmel"
      }
    }
  },
  "$defs": {
    "ActionEvent": {
      "additionalProperties": false,
      "description": "A single spotted action at one frame, with a normalized court location.",
      "properties": {
        "frame": {
          "description": "0-based frame index into the frame cache",
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "label": {
          "description": "One of ACTION_LABELS",
          "title": "Label",
          "type": "string"
        },
        "xy": {
          "description": "Normalized [x, y] court location, each in [0, 1]",
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Xy",
          "type": "array"
        },
        "visible": {
          "default": true,
          "description": "Whether the action is visible on screen",
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "frame",
        "label",
        "xy"
      ],
      "title": "ActionEvent",
      "type": "object"
    },
    "ActionLabelRecord": {
      "additionalProperties": true,
      "description": "One video's worth of action labels \u2014 the unit of a ``*_actions.jsonl`` row.",
      "properties": {
        "video": {
          "description": "Video stem; matches the frame-cache directory name",
          "title": "Video",
          "type": "string"
        },
        "num_frames": {
          "description": "Total frames in the cache for this video",
          "minimum": 0,
          "title": "Num Frames",
          "type": "integer"
        },
        "fps": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "number"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/ActionEvent"
          },
          "title": "Events",
          "type": "array"
        }
      },
      "required": [
        "video",
        "num_frames"
      ],
      "title": "ActionLabelRecord",
      "type": "object"
    },
    "CourtSide": {
      "description": "Where a court side sits in camera-frame terms.\n\nThe value space of the ``winner`` task: which side of the frame the team\nthat WON the rally was playing on. Sideline footage uses left/right,\nbroadcast/baseline footage near/far \u2014 one 4-class vocabulary so a single\nhead serves both camera setups. The winning side, not where the ball\nlanded: an out ball lands on the loser's side.",
      "enum": [
        "left",
        "right",
        "near",
        "far"
      ],
      "title": "CourtSide",
      "type": "string"
    },
    "SegmentLabelEvent": {
      "additionalProperties": false,
      "description": "A label covering a contiguous frame span (e.g. one rally), inclusive.\n\nSegment label files (rally training) reuse the ``ActionLabelRecord`` layout\nwith these events instead of point actions; yp-spot fills every frame of the\nspan with the class during training and evaluates with segment mAP.",
      "properties": {
        "frame": {
          "description": "0-based first frame of the span",
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "end_frame": {
          "description": "0-based last frame of the span, inclusive",
          "minimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "label": {
          "description": "Segment class, e.g. 'rally'",
          "title": "Label",
          "type": "string"
        },
        "winner": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourtSide"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Court side the rally winner was playing on (camera-frame). None = unannotated; the model ignores the span's winner supervision."
        }
      },
      "required": [
        "frame",
        "end_frame",
        "label"
      ],
      "title": "SegmentLabelEvent",
      "type": "object"
    }
  }
}
